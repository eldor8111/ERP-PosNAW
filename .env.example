# DATABASE - Supabase yoki boshqa online PostgreSQL URL ni shu yerga yozing
# Supabase dan olganingizdan keyin: postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/erppos

# Secret key - o'zgartiring! (kamida 32 belgi)
SECRET_KEY=super-secret-key-change-in-production-min-32-chars

# Server public URL (Telegram webhook uchun)
# Misol: https://savdo.e-code.uz
SERVER_URL=

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Payme Merchant API ──────────────────────────────────────────────────────
# Payme Business Cabinet dan olinadi: https://business.paycom.uz
# Merchant API → Kassa → Sozlamalar
PAYME_MERCHANT_ID=your_payme_merchant_id_here
PAYME_SECRET_KEY=your_payme_secret_key_here
# Test rejimi: true = checkout.test.paycom.net | false = checkout.paycom.net
PAYME_IS_TEST=true

# ── Eskiz SMS ───────────────────────────────────────────────────────────────
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# ── AI / LLM sozlamalari ───────────────────────────────────────────────────
LLM_PROVIDER=openrouter
LLM_MODEL_MAIN=cohere/north-mini-code:free
LLM_MODEL_FAST=cohere/north-mini-code:free
LLM_FALLBACK_CHAIN=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_FALLBACK_MODELS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_PROMPT_CACHING=false
LLM_TIMEOUT_SEC=30
LLM_MAX_RETRIES=2
AI_PENDING_ACTION_TTL_MIN=10

# ── AI Readonly Database (run_sql_readonly uchun ajratilgan rol) ──────────────
AI_DB_URL_READONLY=postgresql+psycopg://ai_sql_ro:ai_sql_ro_pass@localhost:5432/erppos
AI_SQL_MAX_ROWS=200
AI_SQL_TIMEOUT_SEC=10

# ── Mir-maza marketplace (T0.18) ──────────────────────────────────────────────
# Mir-maza integratsiya (webhook) kaliti: Mir-maza bizga so'rov yuborganda
# X-Integration-Key sarlavhasi shu qiymat bilan solishtiriladi, biz Mir-maza ga
# so'rov yuborganda Authorization: Bearer <token> sifatida ketadi.
# Qiymatni avval Mir-maza tomoniga bering; bo'sh qolsa webhook rad etiladi va
# mahsulot/buyurtma almashinuvi ishlamaydi.
MARKETPLACE_API_TOKEN=

# ── Uzum Bank Merchant API ──────────────────────────────────────────────────
UZUM_USERNAME=+998933344602
UZUM_PASSWORD=2858171
UZUM_SERVICE_ID=498659320
UZUM_IS_TEST=false
