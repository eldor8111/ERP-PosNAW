        },
        "url": {
          "raw": "{{baseUrl}}/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "create"
          ]
        },
        "description": "To'lovni boshlash va tranzaksiyani yaratish (amount tiyinda: 2 500 000 tiyin = 25 000 so'm)."
