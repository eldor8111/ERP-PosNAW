      "name": "1. Check (To'lov imkoniyatini tekshirish)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": {{serviceId}},\n  \"timestamp\": 1714377645426,\n  \"params\": {\n    \"order_id\": \"{{orderId}}\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/check",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "check"
          ]
        },
        "description": "Uzum Bank ilovasida mijoz hisob raqamini kiritganda to'lov imkoniyatini tekshirish uchun chaqiriladi."
      },
      "response": [
        {
          "name": "200 OK - Muvaffaqiyatli",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": 123123,\n  \"timestamp\": 1714377645426,\n  \"params\": {\n    \"order_id\": \"123123\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/check",
              "host": ["{{baseUrl}}"],
              "path": ["check"]
