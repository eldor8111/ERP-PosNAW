          "body": "{\n  \"serviceId\": 123123,\n  \"timestamp\": 1714377645500,\n  \"status\": \"OK\",\n  \"data\": {\n    \"account\": {\n      \"value\": \"123123\"\n    },\n    \"userInfo\": {\n      \"name\": \"E-Code Test Mijoz\"\n    }\n  }\n}"
        },
        {
          "name": "400 Bad Request - Hisob topilmadi",
          "status": "Bad Request",
          "code": 400,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"serviceId\": 123123,\n  \"timestamp\": 1714377645500,\n  \"status\": \"FAILED\",\n  \"errorCode\": \"10007\"\n}"
        }
      ]
    },
